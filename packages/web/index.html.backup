<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Failora — Find the Failure. Prove the Recovery.</title>
  <meta name="description" content="Failora detects reliability gaps, investigates failures, and verifies recovery with evidence." />
  <meta property="og:title" content="Failora — Find the Failure. Prove the Recovery." />
  <meta property="og:description" content="Detect reliability gaps, investigate failures, and verify recovery with evidence." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#060a12" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23060a12'/%3E%3Cpath d='M7 10l6 6-6 6' stroke='%234ade80' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M16 22h9' stroke='%2322d3ee' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #060a12;
      --panel: #0a1120;
      --panel-2: #0e182b;
      --input-bg: #050913;
      --line: #1a2740;
      --line-2: #26385a;
      --text: #d7e3f4;
      --muted: #8fa1bf;
      --dim: #5b6f90;
      --cyan: #22d3ee;
      --green: #4ade80;
      --amber: #fbbf24;
      --red: #f87171;
      --blue: #60a5fa;
      --violet: #a78bfa;
      --orange: #fb923c;
      --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    [data-theme="light"] {
      --bg: #f4f6fb;
      --panel: #ffffff;
      --panel-2: #eef2f8;
      --input-bg: #f7f9fc;
      --line: #d7dfeb;
      --line-2: #b7c3d6;
      --text: #0e1a2e;
      --muted: #3f4f68;
      --dim: #5d6d86;
      --cyan: #0e7490;
      --green: #15803d;
      --amber: #a16207;
      --red: #b91c1c;
      --blue: #1d4ed8;
      --violet: #6d28d9;
      --orange: #c2410c;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body { font-family: var(--mono); background: var(--bg); color: var(--text); font-size: 15px; line-height: 1.7; overflow-x: hidden; -webkit-font-smoothing: antialiased; transition: background 0.3s, color 0.3s; }
    a { color: inherit; text-decoration: none; }
    button, input { font: inherit; color: inherit; }
    button { cursor: pointer; background: none; border: 0; text-align: left; }
    :focus { outline: none; }
    :focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 4px; }
    ::selection { background: rgba(34,211,238,0.25); }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 22px; }
    section { padding: 90px 0 40px; position: relative; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .skip { position: fixed; top: 8px; left: 8px; z-index: 300; background: var(--cyan); color: #04111f; padding: 8px 14px; border-radius: 6px; font-weight: 700; transform: translateY(-200%); }
    .skip:focus { transform: none; }

    /* ---------- Background ---------- */
    .bg-scan { position: fixed; inset: 0; z-index: -2; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(255,255,255,0.012) 0 1px, transparent 1px 3px); }
    .bg-glow { position: fixed; inset: -10%; z-index: -3; pointer-events: none; background: radial-gradient(800px 500px at 15% 0%, rgba(34,211,238,0.07), transparent 60%), radial-gradient(700px 500px at 90% 30%, rgba(96,165,250,0.06), transparent 60%); }
    [data-theme="light"] .bg-scan { display: none; }

    /* ---------- Terminal window ---------- */
    .term { position: relative; border: 1px solid var(--line-2); border-radius: 12px; background: linear-gradient(180deg, var(--panel), var(--panel-2)); box-shadow: 0 30px 80px rgba(0,0,0,0.35); overflow: hidden; }
    .term-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--panel-2); border-bottom: 1px solid var(--line); font-size: 12px; color: var(--dim); }
    .term-bar .d { width: 11px; height: 11px; border-radius: 50%; background: #2a3a58; }
    .term-bar .d:nth-child(1) { background: #f87171aa; } .term-bar .d:nth-child(2) { background: #fbbf24aa; } .term-bar .d:nth-child(3) { background: #4ade80aa; }
    .term-bar .title { margin-left: 8px; flex: 1; text-align: center; color: var(--muted); }
    .term-bar .tag { font-size: 11px; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--line-2); color: var(--amber); }
    .term-body { padding: 22px 24px; font-size: 14px; }
    .l { display: block; white-space: pre-wrap; word-break: break-word; opacity: 0; transform: translateY(4px); transition: opacity 0.25s ease, transform 0.25s ease; }
    .l.shown { opacity: 1; transform: none; }
    .p { color: var(--cyan); } .ok { color: var(--green); } .warn { color: var(--amber); } .bad { color: var(--red); }
    .info { color: var(--blue); } .k { color: var(--violet); } .m { color: var(--muted); } .d { color: var(--dim); }
    .caret::after { content: "\2588"; margin-left: 4px; color: var(--cyan); animation: blink 1.05s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    /* Copy button */
    .copy { position: absolute; top: 8px; right: 8px; font-size: 11px; padding: 4px 9px; border-radius: 6px; border: 1px solid var(--line-2); color: var(--muted); background: var(--panel); transition: color 0.2s, border-color 0.2s; z-index: 2; }
    .copy:hover { color: var(--cyan); border-color: var(--cyan); }
    .copy[data-state="done"] { color: var(--green); border-color: var(--green); }
    .has-copy { position: relative; }

    /* ---------- Nav ---------- */
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; border-bottom: 1px solid transparent; transition: background 0.3s, border-color 0.3s; }
    .nav.scrolled { background: color-mix(in srgb, var(--bg) 88%, transparent); border-bottom-color: var(--line); backdrop-filter: blur(10px); }
    .nav-in { display: flex; align-items: center; justify-content: space-between; height: 58px; gap: 16px; }
    .brand { font-weight: 800; color: var(--text); font-size: 15px; white-space: nowrap; }
    .brand .pr { color: var(--green); }
    .nav-links { display: flex; gap: 4px; }
    .nav-links a { padding: 6px 10px; border-radius: 6px; color: var(--muted); font-size: 13px; }
    .nav-links a::before { content: "./"; color: var(--dim); }
    .nav-links a:hover, .nav-links a.active { color: var(--cyan); background: rgba(34,211,238,0.08); }
    .nav-right { display: flex; gap: 8px; align-items: center; }
    .nav-right .sign { color: var(--muted); font-size: 13px; padding: 6px 10px; }
    .nav-right .sign:hover { color: var(--text); }
    .icon-btn { border: 1px solid var(--line-2); padding: 6px 10px; border-radius: 6px; color: var(--muted); font-size: 12px; background: var(--panel); transition: color 0.2s, border-color 0.2s; }
    .icon-btn:hover { color: var(--cyan); border-color: var(--cyan); }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 8px; border: 1px solid var(--cyan); background: var(--cyan); color: #04111f; font-weight: 700; font-size: 13px; transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }
    .btn:hover { box-shadow: 0 0 0 4px rgba(34,211,238,0.15), 0 10px 30px rgba(34,211,238,0.2); transform: translateY(-1px); }
    .btn.ghost { background: transparent; color: var(--cyan); }
    .btn.ghost:hover { background: rgba(34,211,238,0.08); }
    .menu-btn { display: none; }
    .mobile { display: none; position: fixed; top: 58px; left: 0; right: 0; background: var(--panel); border-bottom: 1px solid var(--line); padding: 10px 22px; z-index: 99; }
    .mobile.open { display: grid; gap: 6px; }
    .mobile a { color: var(--muted); padding: 8px 0; border-bottom: 1px dashed var(--line); }

    /* ---------- Command palette ---------- */
    .pal-back { position: fixed; inset: 0; z-index: 200; background: rgba(2,4,10,0.6); display: flex; align-items: flex-start; justify-content: center; padding: 14vh 16px 16px; backdrop-filter: blur(4px); }
    .pal-back[hidden] { display: none; }
    .pal { width: min(560px, 100%); border: 1px solid var(--line-2); border-radius: 12px; background: var(--panel); box-shadow: 0 30px 80px rgba(0,0,0,0.5); overflow: hidden; }
    .pal input { width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--line); padding: 14px 16px; color: var(--text); font-size: 15px; outline: 0; }
    .pal input::placeholder { color: var(--dim); opacity: 1; }
    .pal ul { list-style: none; max-height: 340px; overflow: auto; padding: 6px; }
    .pal li button { width: 100%; display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 8px; color: var(--muted); font-size: 14px; }
    .pal li button span:last-child { color: var(--dim); font-size: 12px; }
    .pal li button[aria-selected="true"] { background: rgba(34,211,238,0.1); color: var(--text); }
    .pal .hint { padding: 8px 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--dim); display: flex; gap: 14px; flex-wrap: wrap; }
    kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; color: var(--muted); }

    /* ---------- Hero ---------- */
    .hero { padding-top: 130px; min-height: 100vh; }
    .hero-title { font-size: clamp(2rem, 5.6vw, 4.1rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.02em; margin-top: 26px; }
    .hero-title .g { color: var(--green); }
    .hero-title .c { color: var(--cyan); }
    .hero-sub { margin-top: 16px; color: var(--muted); font-size: 16px; max-width: 680px; }
    .cmd-form { margin-top: 30px; display: grid; gap: 12px; }
    .cmd { display: flex; align-items: center; flex-wrap: wrap; border: 1px solid var(--line-2); border-radius: 10px; background: var(--input-bg); padding: 6px 6px 6px 16px; transition: border-color 0.2s, box-shadow 0.2s; }
    .cmd:focus-within { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34,211,238,0.14); }
    .cmd.invalid { border-color: var(--red); }
    .cmd .pr { color: var(--green); white-space: nowrap; }
    .cmd .bin { color: var(--cyan); white-space: nowrap; margin: 0 10px 0 6px; }
    .cmd input { flex: 1; min-width: 180px; background: transparent; border: 0; outline: 0; padding: 10px 6px; color: var(--text); font-size: 15px; }
    .cmd input::placeholder { color: var(--dim); opacity: 1; }
    .cmd .btn { margin-left: 8px; }
    .form-err { min-height: 1.4em; color: var(--red); font-size: 13px; }
    .form-row { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--dim); }
    .link-btn { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; font-size: 13px; }
    .hero-foot { margin-top: 36px; display: flex; gap: 22px; flex-wrap: wrap; font-size: 13px; color: var(--dim); }
    .hero-foot span::before { content: "[ "; } .hero-foot span::after { content: " ]"; }
    .scan-out { margin-top: 18px; display: none; }
    .scan-out.show { display: block; }
    .sim-note { color: var(--amber); font-size: 12.5px; margin-bottom: 10px; }
    .nojs { margin-top: 14px; font-size: 13px; color: var(--muted); }

    /* ---------- Headings ---------- */
    .cmd-title { font-size: 13px; color: var(--muted); margin-bottom: 14px; }
    .cmd-title .pr { color: var(--green); }
    .cmd-title .arg { color: var(--cyan); }
    .h-big { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.01em; margin-bottom: 18px; }
    .lead { color: var(--muted); margin-bottom: 24px; max-width: 720px; }
    .sub-h { font-size: 13px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.1em; margin: 26px 0 10px; font-weight: 700; }

    /* ---------- Dashboard ---------- */
    .dash-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; }
    .dash-cell { grid-column: span 3; border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; background: color-mix(in srgb, var(--text) 2%, transparent); }
    .dash-cell .lab { font-size: 12px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.08em; }
    .dash-cell .val { font-size: 26px; font-weight: 800; margin-top: 4px; font-variant-numeric: tabular-nums; }
    .dash-cell .val small { font-size: 13px; color: var(--muted); font-weight: 500; }
    .dash-cell .sub { font-size: 12px; color: var(--dim); }
    .dash-cell.wide { grid-column: span 6; }
    .spark { font-size: 20px; letter-spacing: 1px; color: var(--cyan); white-space: nowrap; overflow: hidden; }
    .spark .f { color: var(--red); }
    .sevline { font-size: 13px; white-space: pre; color: var(--muted); margin-top: 8px; font-family: var(--mono); }
    .sevline .bar { color: var(--cyan); } .sevline .bar.r { color: var(--red); } .sevline .bar.o { color: var(--orange); } .sevline .bar.y { color: var(--amber); } .sevline .bar.b { color: var(--blue); }
    .tag-sample { color: var(--amber); border: 1px solid rgba(251,191,36,0.4); padding: 1px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; }
    .list-rows { font-size: 13px; color: var(--muted); margin-top: 8px; }
    .list-rows div { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; border-bottom: 1px dashed var(--line); }
    .list-rows div:last-child { border-bottom: 0; }
    .report-note { margin-top: 12px; font-size: 12.5px; color: var(--dim); }

    /* ---------- Features table ---------- */
    .table { border: 1px solid var(--line-2); border-radius: 10px; overflow: hidden; background: color-mix(in srgb, var(--panel) 80%, transparent); }
    .trow { display: grid; grid-template-columns: 118px 1.1fr 1.5fr; gap: 16px; padding: 16px 18px; border-bottom: 1px solid var(--line); align-items: start; transition: background 0.2s; }
    .trow:last-child { border-bottom: 0; }
    .trow:hover { background: rgba(34,211,238,0.035); }
    .trow .st { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 4px; text-align: center; white-space: nowrap; width: fit-content; }
    .st.av { color: var(--green); border: 1px solid rgba(74,222,128,0.4); }
    .st.pl { color: var(--violet); border: 1px solid rgba(167,139,250,0.4); }
    .trow .nm { font-weight: 700; }
    .trow .ds { color: var(--muted); font-size: 14px; margin-top: 4px; }
    .trow .ex { color: var(--dim); font-size: 12.5px; }
    .trow .ex b { color: var(--amber); font-weight: 500; }

    /* ---------- Pipeline ---------- */
    .pipe { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line-2); border-radius: 10px; overflow: hidden; }
    .stage { padding: 22px 20px; border-right: 1px solid var(--line); background: color-mix(in srgb, var(--panel) 60%, transparent); position: relative; transition: background 0.4s; }
    .stage:last-child { border-right: 0; }
    .stage .n { font-size: 12px; color: var(--dim); }
    .stage h3 { font-size: 18px; font-weight: 800; margin-top: 6px; }
    .stage p { color: var(--muted); font-size: 13.5px; margin-top: 8px; }
    .stage .arrow { position: absolute; right: -11px; top: 50%; transform: translateY(-50%); z-index: 2; color: var(--cyan); background: var(--bg); width: 22px; text-align: center; font-size: 16px; }
    .stage:last-child .arrow { display: none; }
    .stage.on { background: rgba(34,211,238,0.06); }
    .stage.on h3 { color: var(--cyan); }
    .stage .state { margin-top: 12px; font-size: 12px; color: var(--dim); }
    .stage.on .state { color: var(--green); }

    /* ---------- Quickstart / API ---------- */
    .cmdblock { border: 1px solid var(--line-2); border-radius: 10px; background: var(--input-bg); padding: 18px 20px; font-size: 13.5px; overflow-x: auto; }
    .cmdblock .row { display: block; white-space: pre; color: var(--text); }
    .cmdblock .row .pr { color: var(--green); }
    .cmdblock .row .cm { color: var(--dim); }
    .tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .tbl th, .tbl td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .tbl th { color: var(--dim); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }
    .tbl td:first-child { white-space: nowrap; }
    .tbl .meth { color: var(--cyan); font-weight: 700; }
    .tbl code { color: var(--text); }
    .tbl-wrap { border: 1px solid var(--line-2); border-radius: 10px; overflow-x: auto; background: var(--panel); }

    /* ---------- Sample report ---------- */
    .report-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 14px; font-size: 13px; color: var(--muted); }
    .report-meta div { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
    .report-meta b { display: block; color: var(--text); font-weight: 700; }
    .findings { border: 1px solid var(--line-2); border-radius: 10px; overflow: hidden; }
    .f-item { border-bottom: 1px solid var(--line); }
    .f-item:last-child { border-bottom: 0; }
    .f-btn { width: 100%; display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 14px 18px; transition: background 0.2s; }
    .f-btn:hover { background: rgba(127,127,127,0.06); }
    .sev { font-size: 12px; font-weight: 800; padding: 2px 8px; border-radius: 4px; width: 84px; text-align: center; }
    .sev.high { color: var(--orange); border: 1px solid rgba(251,146,60,0.45); }
    .sev.med { color: var(--amber); border: 1px solid rgba(251,191,36,0.45); }
    .sev.low { color: var(--blue); border: 1px solid rgba(96,165,250,0.45); }
    .f-title { font-weight: 600; }
    .f-meta { color: var(--dim); font-size: 12.5px; }
    .f-toggle { color: var(--cyan); font-size: 13px; transition: transform 0.25s; }
    .f-btn[aria-expanded="true"] .f-toggle { transform: rotate(90deg); }
    .f-panel { display: none; padding: 4px 18px 22px; }
    .f-panel.open { display: block; animation: rise 0.35s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .f-panel h4 { font-size: 12px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.1em; margin: 16px 0 6px; font-weight: 700; }
    .f-panel p, .f-panel li { color: var(--muted); font-size: 14px; }
    .f-panel ol { padding-left: 22px; }
    .code { background: var(--input-bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; font-size: 12.5px; color: var(--text); overflow-x: auto; white-space: pre; line-height: 1.7; }
    .code .c { color: var(--dim); } .code .r { color: var(--red); } .code .g { color: var(--green); } .code .k { color: var(--violet); }
    .verdict { display: inline-block; margin-top: 4px; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 4px; }
    .verdict.v { color: var(--green); border: 1px solid rgba(74,222,128,0.45); }
    .verdict.p { color: var(--amber); border: 1px solid rgba(251,191,36,0.45); }
    .verdict.q { color: var(--blue); border: 1px solid rgba(96,165,250,0.45); }
    .honest { margin-top: 14px; border-left: 2px solid var(--amber); padding: 8px 14px; font-size: 13px; color: var(--muted); background: rgba(251,191,36,0.05); border-radius: 0 8px 8px 0; }
    .honest b { color: var(--amber); font-weight: 700; }

    /* ---------- Why / Privacy / Status ---------- */
    .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .lines { font-size: 14px; color: var(--muted); display: grid; gap: 10px; }
    .lines div::before { content: "- "; color: var(--cyan); }
    .lines b { color: var(--text); font-weight: 600; }
    .status-list { font-size: 14px; display: grid; gap: 8px; }
    .status-list div { display: flex; gap: 12px; align-items: baseline; }
    .status-list .s1 { min-width: 110px; font-weight: 700; }
    .status-list .s1.a { color: var(--green); } .status-list .s1.p { color: var(--violet); }

    /* ---------- FAQ ---------- */
    .faq { display: grid; gap: 10px; }
    .faq details { border: 1px solid var(--line-2); border-radius: 10px; background: color-mix(in srgb, var(--panel) 80%, transparent); }
    .faq details[open] { border-color: var(--cyan); }
    .faq summary { list-style: none; cursor: pointer; padding: 16px 18px; font-weight: 700; display: flex; justify-content: space-between; gap: 12px; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: "+"; color: var(--cyan); font-size: 18px; line-height: 1; }
    .faq details[open] summary::after { content: "-"; }
    .faq .ans { padding: 0 18px 18px; color: var(--muted); font-size: 14px; }

    /* ---------- Final ---------- */
    .final { padding: 90px 0 60px; }
    .final h2 { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; line-height: 1.2; }
    .final h2 .g { color: var(--green); }
    .final .row { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }

    /* ---------- Footer ---------- */
    footer { border-top: 1px solid var(--line); padding: 34px 0 40px; color: var(--dim); font-size: 13px; }
    .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 26px; }
    .foot h5 { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
    .foot a { display: block; padding: 3px 0; color: var(--dim); }
    .foot a:hover { color: var(--cyan); }
    .foot-end { margin-top: 26px; padding-top: 16px; border-top: 1px dashed var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

    /* ---------- Reveal ---------- */
    .reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.in { opacity: 1; transform: none; }

    /* ---------- Responsive ---------- */
    @media (max-width: 960px) {
      .nav-links { display: none; }
      .nav-right .sign, .nav-right .kbd-hint { display: none; }
      .menu-btn { display: inline-block; }
      .dash-cell, .dash-cell.wide { grid-column: span 6; }
      .pipe { grid-template-columns: repeat(2, 1fr); }
      .stage:nth-child(2) { border-right: 0; }
      .stage { border-bottom: 1px solid var(--line); }
      .stage .arrow { display: none; }
      .foot { grid-template-columns: 1fr 1fr; }
      .two { grid-template-columns: 1fr; }
    }
    @media (max-width: 700px) {
      section { padding: 70px 0 30px; }
      .hero { padding-top: 110px; }
      .cmd { padding: 8px 10px; }
      .cmd .pr, .cmd .bin { font-size: 13px; }
      .cmd .btn { width: 100%; justify-content: center; margin: 8px 0 0; }
      .cmd input { min-width: 0; width: 100%; }
      .trow { grid-template-columns: 1fr; gap: 8px; }
      .pipe { grid-template-columns: 1fr; }
      .stage { border-right: 0; }
      .dash-cell, .dash-cell.wide { grid-column: span 12; }
      .report-meta { grid-template-columns: 1fr; }
      .f-btn { grid-template-columns: auto 1fr; }
      .f-toggle { display: none; }
      .foot { grid-template-columns: 1fr; }
      .term-body { padding: 16px; }
      .cmdblock { font-size: 12.5px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      .l, .reveal { opacity: 1 !important; transform: none !important; }
    }

    /* ---------- Print: report and features readable on paper ---------- */
    @media print {
      :root, [data-theme="light"] { --bg: #fff; --panel: #fff; --panel-2: #fff; --input-bg: #fff; --line: #ccc; --line-2: #999; --text: #000; --muted: #333; --dim: #555; --cyan: #000; --green: #000; --amber: #000; --red: #000; --blue: #000; --violet: #000; --orange: #000; }
      body { background: #fff; color: #000; }
      .nav, .mobile, .pal-back, .bg-scan, .bg-glow, .copy, .cmd-form, .scan-out, .hero, #features, #how, #product, #status, #docs, #start, .foot, footer, .link-btn, .hero-foot { display: none !important; }
      section { padding: 10px 0; }
      .reveal { opacity: 1 !important; transform: none !important; }
      .f-panel { display: block !important; }
      .term, .findings, .tbl-wrap, .cmdblock { box-shadow: none; }
      .report-note { display: block; }
    }
    /* ---------- Auth Modal ---------- */
    .auth-back { position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); z-index: 100; display: none; align-items: center; justify-content: center; padding: 20px; }
    .auth-back.open { display: flex; }
    .auth-modal { background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px; width: 100%; max-width: 420px; box-shadow: 0 24px 64px rgba(0,0,0,0.5); overflow: hidden; }
    .auth-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--line); }
    .auth-head h2 { font-size: 14px; font-weight: 700; color: var(--green); margin: 0; }
    .auth-head h2::before { content: '$ '; color: var(--dim); }
    .auth-close { color: var(--dim); font-size: 18px; padding: 4px 8px; border-radius: 4px; }
    .auth-close:hover { color: var(--text); background: var(--panel-2); }
    .auth-tabs { display: flex; border-bottom: 1px solid var(--line); }
    .auth-tab { flex: 1; padding: 12px; text-align: center; font-size: 13px; font-weight: 600; color: var(--dim); border-bottom: 2px solid transparent; cursor: pointer; background: none; border-top: 0; border-left: 0; border-right: 0; }
    .auth-tab.active { color: var(--cyan); border-bottom-color: var(--cyan); }
    .auth-body { padding: 20px; }
    .auth-field { margin-bottom: 14px; }
    .auth-field label { display: block; font-size: 12px; color: var(--dim); margin-bottom: 4px; }
    .auth-field label::before { content: '> '; color: var(--green); }
    .auth-input { width: 100%; padding: 10px 12px; background: var(--input-bg); border: 1px solid var(--line); border-radius: 6px; color: var(--text); font-family: var(--mono); font-size: 14px; outline: none; transition: border-color 0.2s; }
    .auth-input:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34,211,238,0.1); }
    .auth-input::placeholder { color: var(--dim); opacity: 0.5; }
    .auth-err { padding: 10px 12px; background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 6px; color: var(--red); font-size: 13px; margin-bottom: 12px; display: none; }
    .auth-err.show { display: block; }
    .auth-success { padding: 10px 12px; background: rgba(74,222,128,0.1); border: 1px solid rgba(74,222,128,0.3); border-radius: 6px; color: var(--green); font-size: 13px; margin-bottom: 12px; display: none; }
    .auth-success.show { display: block; }
    .auth-submit { width: 100%; padding: 12px; background: var(--cyan); color: var(--bg); border: 0; border-radius: 6px; font-family: var(--mono); font-size: 14px; font-weight: 700; cursor: pointer; transition: opacity 0.2s; }
    .auth-submit:hover { opacity: 0.9; }
    .auth-submit:disabled { opacity: 0.5; cursor: not-allowed; }
    .auth-submit .pr { color: var(--bg); }
    .auth-switch { text-align: center; margin-top: 14px; font-size: 13px; color: var(--dim); }
    .auth-switch a { color: var(--cyan); cursor: pointer; }
    .auth-switch a:hover { text-decoration: underline; }
    .auth-user { display: flex; align-items: center; gap: 8px; }
    .auth-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--cyan); color: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
    .auth-name { font-size: 13px; color: var(--text); }
    .auth-logout { font-size: 12px; color: var(--dim); cursor: pointer; }
    .auth-logout:hover { color: var(--red); }

    /* ---------- Report Panel ---------- */
    .report-panel { background: var(--panel); border: 1px solid var(--line-2); border-radius: 10px; padding: 20px; margin-top: 20px; }
    .report-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
    .report-header h3 { margin: 0; font-size: 14px; color: var(--green); }
    .report-header h3::before { content: '$ '; color: var(--dim); }
    .report-score { font-size: 28px; font-weight: 800; }
    .report-score.good { color: var(--green); }
    .report-score.warn { color: var(--amber); }
    .report-score.bad { color: var(--red); }
    .report-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .report-meta-item { background: var(--panel-2); padding: 10px; border-radius: 6px; }
    .report-meta-item .k { font-size: 11px; color: var(--dim); text-transform: uppercase; }
    .report-meta-item .v { font-size: 16px; font-weight: 700; color: var(--text); }
    .report-findings { display: grid; gap: 8px; }
    .report-finding { padding: 12px; background: var(--panel-2); border-radius: 6px; border-left: 3px solid var(--line-2); }
    .report-finding.critical { border-left-color: var(--red); }
    .report-finding.high { border-left-color: var(--orange); }
    .report-finding.medium { border-left-color: var(--amber); }
    .report-finding.low { border-left-color: var(--blue); }
    .report-finding .sev { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; display: inline-block; margin-bottom: 6px; }
    .report-finding.critical .sev { background: rgba(248,113,113,0.2); color: var(--red); }
    .report-finding.high .sev { background: rgba(251,146,60,0.2); color: var(--orange); }
    .report-finding.medium .sev { background: rgba(251,191,36,0.2); color: var(--amber); }
    .report-finding.low .sev { background: rgba(96,165,250,0.2); color: var(--blue); }
    .report-finding .title { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
    .report-finding .desc { font-size: 12px; color: var(--muted); }
    .report-finding .loc { font-size: 11px; color: var(--dim); margin-top: 4px; font-family: var(--mono); }
    .report-finding .fix { font-size: 12px; color: var(--cyan); margin-top: 6px; }
    .report-finding .fix::before { content: '→ '; }
    .report-empty { text-align: center; padding: 40px; color: var(--dim); font-size: 13px; }
    .report-empty .icon { font-size: 32px; margin-bottom: 8px; }

    /* ---------- Console (Dashboard) ---------- */
    .console-page { display: none; min-height: 100vh; background: var(--bg); }
    .console-page.active { display: block; }
    .landing-page.hidden { display: none; }
    .console-shell { max-width: 1200px; margin: 0 auto; padding: 80px 24px 40px; }
    .console-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
    .console-head h1 { margin: 0; font-size: 18px; color: var(--green); }
    .console-head h1::before { content: '$ '; color: var(--dim); }
    .console-user { display: flex; align-items: center; gap: 10px; }
    .console-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--cyan); color: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
    .console-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .console-card { background: var(--panel); border: 1px solid var(--line-2); border-radius: 10px; padding: 20px; }
    .console-card h3 { margin: 0 0 12px; font-size: 13px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.5px; }
    .console-card h3::before { content: '> '; color: var(--green); }
    .console-stat { display: flex; align-items: baseline; gap: 8px; }
    .console-stat .num { font-size: 32px; font-weight: 800; color: var(--text); }
    .console-stat .lbl { font-size: 12px; color: var(--dim); }
    .console-scan-form { display: flex; gap: 8px; margin-bottom: 24px; }
    .console-scan-input { flex: 1; padding: 12px 14px; background: var(--input-bg); border: 1px solid var(--line); border-radius: 6px; color: var(--text); font-family: var(--mono); font-size: 14px; outline: none; }
    .console-scan-input:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34,211,238,0.1); }
    .console-scan-btn { padding: 12px 20px; background: var(--cyan); color: var(--bg); border: 0; border-radius: 6px; font-family: var(--mono); font-size: 14px; font-weight: 700; cursor: pointer; }
    .console-scan-btn:hover { opacity: 0.9; }
    .console-scan-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .console-table { width: 100%; border-collapse: collapse; }
    .console-table th { text-align: left; padding: 10px 12px; font-size: 11px; color: var(--dim); text-transform: uppercase; border-bottom: 1px solid var(--line); }
    .console-table td { padding: 12px; font-size: 13px; border-bottom: 1px solid var(--line); }
    .console-table tr:hover td { background: var(--panel-2); }
    .badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    .badge.completed { background: rgba(74,222,128,0.15); color: var(--green); }
    .badge.failed { background: rgba(248,113,113,0.15); color: var(--red); }
    .badge.running { background: rgba(251,191,36,0.15); color: var(--amber); }
    .badge.pending { background: rgba(96,165,250,0.15); color: var(--blue); }
    .console-empty { text-align: center; padding: 60px 20px; color: var(--dim); }
    .console-empty .icon { font-size: 40px; margin-bottom: 12px; }
    .console-empty p { margin: 0 0 16px; font-size: 14px; }
    .console-term { background: var(--bg2); border: 1px solid var(--line-2); border-radius: 10px; padding: 16px; margin-top: 16px; font-family: var(--mono); font-size: 13px; max-height: 400px; overflow-y: auto; }
    .console-term .tl { margin-bottom: 6px; }
    .console-term .ok { color: var(--green); }
    .console-term .err { color: var(--red); }
    .console-term .warn { color: var(--amber); }
    .console-term .info { color: var(--cyan); }
    .console-term .dim { color: var(--dim); }
    .back-link { color: var(--dim); font-size: 13px; cursor: pointer; margin-bottom: 16px; display: inline-block; }
    .back-link:hover { color: var(--cyan); }
    .console-quick { display: flex; gap: 8px; flex-wrap: wrap; }
    .console-quick button { padding: 8px 14px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; color: var(--dim); font-family: var(--mono); font-size: 12px; cursor: pointer; transition: all 0.2s; }
    .console-quick button:hover { border-color: var(--cyan); color: var(--cyan); }

  </style>
</head>
<body>

  <a href="#main" class="skip">Skip to content</a>
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="bg-scan" aria-hidden="true"></div>

  <!-- ===================== LANDING PAGE WRAPPER ===================== -->
  <div class="landing-page" id="landingPage">

  <!-- ===================== NAV ===================== -->
  <header class="nav" id="nav">
    <div class="wrap nav-in">
      <a href="#top" class="brand" aria-label="Failora home"><span class="pr">$</span> failora</a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#product" data-nav>product</a>
        <a href="#features" data-nav>features</a>
        <a href="#how" data-nav>how-it-works</a>
        <a href="#quickstart" data-nav>quickstart</a>
        <a href="#docs" data-nav>docs</a>
      </nav>
      <div class="nav-right">
        <button class="icon-btn kbd-hint" id="palBtn" type="button" aria-haspopup="dialog">search <kbd>Ctrl K</kbd></button>
        <button class="icon-btn" id="themeBtn" type="button" aria-pressed="false" aria-label="Switch to light theme">light</button>
        <div class="auth-user" id="authUser" style="display:none;">
          <div class="auth-avatar" id="authAvatar">?</div>
          <span class="auth-name" id="authName"></span>
          <span class="auth-logout" id="authLogout">logout</span>
        </div>
        <button class="sign" id="signInBtn" type="button">sign in</button>
        <a href="#start" class="btn">Get Started</a>
        <button class="icon-btn menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mobile" aria-label="Open menu" type="button">menu</button>
      </div>
    </div>
  </header>
  <nav class="mobile" id="mobile" aria-label="Mobile">
    <a href="#product">product</a>
    <a href="#features">features</a>
    <a href="#how">how-it-works</a>
    <a href="#quickstart">quickstart</a>
    <a href="#docs">docs</a>
    <button class="sign" id="mobileSignIn" type="button">sign in</button>
  </nav>

  <!-- ===================== AUTH MODAL ===================== -->
  <div class="auth-back" id="authBack">
    <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="authTitle">
      <div class="auth-head">
        <h2 id="authTitle">auth</h2>
        <button class="auth-close" id="authClose" type="button" aria-label="Close">&times;</button>
      </div>
      <div class="auth-tabs">
        <button class="auth-tab active" id="tabLogin" type="button">sign in</button>
        <button class="auth-tab" id="tabRegister" type="button">register</button>
      </div>
      <div class="auth-body">
        <div class="auth-err" id="authErr"></div>
        <div class="auth-success" id="authSuccess"></div>

        <form id="loginForm">
          <div class="auth-field">
            <label for="loginEmail">email</label>
            <input class="auth-input" id="loginEmail" type="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <div class="auth-field">
            <label for="loginPass">password</label>
            <input class="auth-input" id="loginPass" type="password" placeholder="••••••••" required autocomplete="current-password" />
          </div>
          <button class="auth-submit" type="submit"><span class="pr">$</span> failora login</button>
        </form>

        <form id="registerForm" style="display:none;">
          <div class="auth-field">
            <label for="regName">name</label>
            <input class="auth-input" id="regName" type="text" placeholder="Your name" required autocomplete="name" />
          </div>
          <div class="auth-field">
            <label for="regEmail">email</label>
            <input class="auth-input" id="regEmail" type="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <div class="auth-field">
            <label for="regPass">password</label>
            <input class="auth-input" id="regPass" type="password" placeholder="min 6 characters" required minlength="6" autocomplete="new-password" />
          </div>
          <button class="auth-submit" type="submit"><span class="pr">$</span> failora register</button>
        </form>

        <div class="auth-switch">
          <span id="switchText">No account?</span>
          <a id="switchLink">Register</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== COMMAND PALETTE ===================== -->
  <div class="pal-back" id="palBack" hidden>
    <div class="pal" role="dialog" aria-modal="true" aria-labelledby="palLabel">
      <label id="palLabel" class="sr-only">Jump to a section</label>
      <input id="palInput" type="text" placeholder="jump to a section..." autocomplete="off" />
      <ul id="palList" role="listbox" aria-label="Sections"></ul>
      <div class="hint"><span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> move</span><span><kbd>Enter</kbd> go</span><span><kbd>Esc</kbd> close</span><span><kbd>/</kbd> focus scan input</span></div>
    </div>
  </div>

  <main id="main">

  <!-- ===================== HERO ===================== -->
  <header class="hero wrap" id="top">
    <div class="term reveal in">
      <div class="term-bar">
        <span class="d"></span><span class="d"></span><span class="d"></span>
        <span class="title">failora ~ zsh</span>
        <span class="tag">v0.1.0</span>
      </div>
      <div class="term-body">
        <div><span style="color:var(--green)">$</span> <span class="p">failora</span> <span class="m">--tagline</span></div>
        <div class="hero-title" id="heroTitle" aria-label="Find the Failure. Prove the Recovery.">
          <span class="g">&gt;</span> Find the Failure.<br />
          <span class="c">&gt;</span> Prove the Recovery.
        </div>
        <p class="hero-sub">Detect reliability gaps, investigate failures, and verify recovery with evidence.</p>

        <form class="cmd-form" id="scanForm" novalidate>
          <label class="sr-only" for="target">Website URL or GitHub repository</label>
          <div class="cmd" id="cmdBox">
            <span class="pr">$</span><span class="bin">failora scan</span>
            <input id="target" name="target" type="text" inputmode="url" autocomplete="off" spellcheck="false"
                   placeholder="https://your-site.com" aria-describedby="formErr formNote" />
            <button type="submit" class="btn">Scan Project</button>
          </div>
          <div class="form-err" id="formErr" role="alert"></div>
          <div class="form-row" id="formNote">
            <span>Live scan — sends request to local Failora API at <code>127.0.0.1:4200</code>.</span>
            <button type="button" class="link-btn" id="sampleBtn">Try a sample report</button>
          </div>
        </form>

        <noscript><p class="nojs">JavaScript is off. The scan demo and expandable findings need JavaScript. The rest of the page reads normally.</p></noscript>

        <div class="scan-out term" id="scanOut" role="status" aria-live="polite">
          <div class="term-bar"><span class="d"></span><span class="d"></span><span class="d"></span><span class="title">failora scan</span><span class="tag">simulated</span></div>
          <div class="term-body" id="scanLines">
            <p class="sim-note">Simulation: no request is sent and no real scan runs. Real scanning is not part of the current release.</p>
          </div>
        </div>

        <div class="hero-foot">
          <span>public URLs and repositories</span>
          <span>evidence for every finding</span>
          <span>repeatable regression tests</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ===================== DASHBOARD ===================== -->
  <section id="product">
    <div class="wrap">
      <div class="cmd-title reveal"><span class="pr">$</span> failora dashboard <span class="arg">--sample</span></div>
      <div class="term reveal">
        <div class="term-bar">
          <span class="d"></span><span class="d"></span><span class="d"></span>
          <span class="title">app.failora.dev / acme-checkout</span>
          <span class="tag-sample">SAMPLE DATA</span>
        </div>
        <div class="term-body">
          <div class="dash-grid">
            <div class="dash-cell"><div class="lab">Uptime</div><div class="val"><span data-count="99.94" data-dec="2">0</span><small>%</small></div><div class="sub">+0.12% vs 7d</div></div>
            <div class="dash-cell"><div class="lab">Avg response p50</div><div class="val"><span data-count="238">0</span><small>ms</small></div><div class="sub">-18 ms vs 7d</div></div>
            <div class="dash-cell"><div class="lab">Open issues</div><div class="val"><span data-count="17">0</span></div><div class="sub" style="color:var(--red)">+3 since last scan</div></div>
            <div class="dash-cell"><div class="lab">Recovery tests</div><div class="val"><span data-count="12">0</span><small>/14 passing</small></div><div class="sub">2 need a fallback fix</div></div>

            <div class="dash-cell wide">
              <div class="lab">Heartbeat, last 60 checks</div>
              <div class="spark" id="heartbeat" aria-hidden="true"></div>
              <div class="sub">red = failed check</div>
            </div>
            <div class="dash-cell wide">
              <div class="lab">Response time, last 24h</div>
              <div class="spark" id="latency" aria-hidden="true"></div>
              <div class="sub">p50 in ms, sample series</div>
            </div>

            <div class="dash-cell wide">
              <div class="lab">Issues by severity</div>
              <pre class="sevline" id="sevBars" aria-label="Sample issues by severity"></pre>
            </div>
            <div class="dash-cell wide">
              <div class="lab">Recovery test results</div>
              <div class="list-rows">
                <div><span>timeout -&gt; retry -&gt; success</span><span class="ok">PASS 412ms</span></div>
                <div><span>HTTP 429 honors Retry-After</span><span class="ok">PASS 3/3</span></div>
                <div><span>malformed JSON -&gt; fallback</span><span class="bad">GAP</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="report-note">All values on this preview are sample data, not a live monitor.</p>
    </div>
  </section>

  <!-- ===================== FEATURES ===================== -->
  <section id="features">
    <div class="wrap">
      <div class="cmd-title reveal"><span class="pr">$</span> failora detect <span class="arg">--list</span></div>
      <h2 class="h-big reveal">What Failora detects</h2>
      <p class="lead reveal">Each category is marked as available today or planned. Examples show the kind of finding you would see, not live results.</p>

      <div class="table reveal" role="table" aria-label="Detection categories and status">
        <div class="trow" role="row">
          <div role="cell"><span class="st av">AVAILABLE</span></div>
          <div role="cell"><div class="nm">AI retry, fallback and recovery</div><div class="ds">Checks whether retries and fallbacks actually run when an AI call fails.</div></div>
          <div role="cell"><div class="ex">example: <b>HTTP 429 received, no retry and no fallback.</b></div></div>
        </div>
        <div class="trow" role="row">
          <div role="cell"><span class="st av">AVAILABLE</span></div>
          <div role="cell"><div class="nm">API failures and performance</div><div class="ds">Runs timeout, 429, 500 and malformed scenarios against an endpoint.</div></div>
          <div role="cell"><div class="ex">example: <b>POST /respond: 6% HTTP 500 in the sample run.</b></div></div>
        </div>
        <div class="trow" role="row">
          <div role="cell"><span class="st av">AVAILABLE</span></div>
          <div role="cell"><div class="nm">Regression tests from failures</div><div class="ds">Turns a failing scenario into a repeatable test.</div></div>
          <div role="cell"><div class="ex">example: <b>timeout scenario saved as a test for every commit.</b></div></div>
        </div>
        <div class="trow" role="row">
          <div role="cell"><span class="st pl">PLANNED</span></div>
          <div role="cell"><div class="nm">Website health and availability</div><div class="ds">Checks that a public URL responds, and how fast it does.</div></div>
          <div role="cell"><div class="ex">example: <b>homepage returned 503 on 2 of 20 checks.</b></div></div>
        </div>
        <div class="trow" role="row">
          <div role="cell"><span class="st pl">PLANNED</span></div>
          <div role="cell"><div class="nm">Security and configuration gaps</div><div class="ds">Flags missing headers and settings that weaken a deployment.</div></div>
          <div role="cell"><div class="ex">example: <b>Content-Security-Policy header is not set.</b></div></div>
        </div>
        <div class="trow" role="row">
          <div role="cell"><span class="st pl">PLANNED</span></div>
          <div role="cell"><div class="nm">Repository reliability issues</div><div class="ds">Finds code paths that can hang or fail without handling.</div></div>
          <div role="cell"><div class="ex">example: <b>src/client.ts:42 fetch() has no timeout.</b></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section id="how">
    <div class="wrap">
      <div class="cmd-title reveal"><span class="pr">$</span> failora pipeline <span class="arg">--run</span></div>
      <h2 class="h-big reveal">How it works</h2>
      <div class="pipe reveal" id="pipe">
        <div class="stage" data-stage>
          <div class="n">step 01</div><h3>Scan</h3>
          <p>Website or GitHub repository analyzed.</p>
          <div class="state">waiting</div><span class="arrow" aria-hidden="true">&rarr;</span>
        </div>
        <div class="stage" data-stage>
          <div class="n">step 02</div><h3>Detect</h3>
          <p>Potential gaps and failures identified.</p>
          <div class="state">waiting</div><span class="arrow" aria-hidden="true">&rarr;</span>
        </div>
        <div class="stage" data-stage>
          <div class="n">step 03</div><h3>Verify</h3>
          <p>Recovery behavior and fixes tested.</p>
          <div class="state">waiting</div><span class="arrow" aria-hidden="true">&rarr;</span>
        </div>
        <div class="stage" data-stage>
          <div class="n">step 04</div><h3>Prevent</h3>
          <p>Regression tests and evidence reports created.</p>
          <div class="state">waiting</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== QUICKSTART + API (real commands from the repo README) ===================== -->
  <section id="quickstart">
    <div class="wrap">
      <div class="cmd-title reveal"><span class="pr">$</span> failora quickstart <span class="arg">--from-readme</span></div>
      <h2 class="h-big reveal">Run it locally in a few commands</h2>
      <p class="lead reveal">These are the commands from the project README. Nothing here is simulated.</p>

      <div class="cmdblock has-copy reveal" id="installBlock" data-copy="git clone https://github.com/madhavikodale/Failora.git
cd Failora
npm install
cp .env.example .env
npm run mock-ai
npm run start --workspace=packages/api
npm run test
npm run typecheck">
        <span class="row"><span class="pr">$</span> git clone https://github.com/madhavikodale/Failora.git</span>
        <span class="row"><span class="pr">$</span> cd Failora</span>
        <span class="row"><span class="pr">$</span> npm install</span>
        <span class="row"><span class="pr">$</span> cp .env.example .env</span>
        <span class="row"><span class="pr">$</span> npm run mock-ai <span class="cm"># mock AI service, bound to 127.0.0.1</span></span>
        <span class="row"><span class="pr">$</span> npm run start --workspace=packages/api <span class="cm"># API on port 4200</span></span>
        <span class="row"><span class="pr">$</span> npm run test</span>
        <span class="row"><span class="pr">$</span> npm run typecheck</span>
      </div>

      <div class="sub-h reveal">API endpoints</div>
      <div class="tbl-wrap reveal">
        <table class="tbl">
          <thead><tr><th scope="col">Method</th><th scope="col">Endpoint</th><th scope="col">Description</th></tr></thead>
          <tbody>
            <tr><td class="meth">GET</td><td><code>/health</code></td><td>Health check</td></tr>
            <tr><td class="meth">POST</td><td><code>/targets</code></td><td>Create a test target</td></tr>
            <tr><td class="meth">GET</td><td><code>/targets</code></td><td>List all targets</td></tr>
            <tr><td class="meth">GET</td><td><code>/targets/:id</code></td><td>Get target by ID</td></tr>
            <tr><td class="meth">DELETE</td><td><code>/targets/:id</code></td><td>Delete target</td></tr>
            <tr><td class="meth">POST</td><td><code>/runs</code></td><td>Execute a scenario (async, returns 202)</td></tr>
            <tr><td class="meth">GET</td><td><code>/runs?target_id=</code></td><td>List runs, filtered by target</td></tr>
            <tr><td class="meth">GET</td><td><code>/runs/:id</code></td><td>Get run result</td></tr>
          </tbody>
        </table>
      </div>

      <div class="sub-h reveal">Mock AI failure modes</div>
      <div class="tbl-wrap reveal">
        <table class="tbl">
          <thead><tr><th scope="col">Request</th><th scope="col">What it does</th></tr></thead>
          <tbody>
            <tr><td><code>ANY /respond?mode=ok</code></td><td>Normal 200 response</td></tr>
            <tr><td><code>ANY /respond?mode=slow&amp;delay=5000</code></td><td>Delays, then responds. Use for timeout tests</td></tr>
            <tr><td><code>ANY /respond?mode=429</code></td><td>Returns HTTP 429 with Retry-After</td></tr>
            <tr><td><code>ANY /respond?mode=500</code></td><td>Returns HTTP 500</td></tr>
            <tr><td><code>ANY /respond?mode=malformed</code></td><td>Returns invalid JSON</td></tr>
          </tbody>
        </table>
      </div>

      <div class="sub-h reveal">Create a target and run a scenario</div>
      <div class="cmdblock has-copy reveal" data-copy="curl -X POST http://127.0.0.1:4200/targets -H &quot;Content-Type: application/json&quot; -d '{&quot;name&quot;:&quot;my-api&quot;,&quot;url&quot;:&quot;http://127.0.0.1:4100/respond&quot;}'
curl -X POST http://127.0.0.1:4200/runs -H &quot;Content-Type: application/json&quot; -d '{&quot;target_id&quot;:&quot;TARGET_ID&quot;,&quot;mode&quot;:&quot;timeout&quot;,&quot;timeout_ms&quot;:1000,&quot;max_retries&quot;:2}'
curl http://127.0.0.1:4200/runs/RUN_ID">
        <span class="row"><span class="pr">$</span> curl -X POST http://127.0.0.1:4200/targets -H "Content-Type: application/json" \</span>
        <span class="row">    -d '{"name":"my-api","url":"http://127.0.0.1:4100/respond"}'</span>
        <span class="row"><span class="pr">$</span> curl -X POST http://127.0.0.1:4200/runs -H "Content-Type: application/json" \</span>
        <span class="row">    -d '{"target_id":"TARGET_ID","mode":"timeout","timeout_ms":1000,"max_retries":2}'</span>
        <span class="row"><span class="pr">$</span> curl http://127.0.0.1:4200/runs/RUN_ID</span>
      </div>
      <p class="report-note reveal">Replace TARGET_ID and RUN_ID with the values returned by the API.</p>
    </div>
  </section>


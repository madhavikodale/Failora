  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const esc = (s) => String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

    /* ---------- Theme (light / dark), remembered per browser ---------- */
    const themeBtn = document.getElementById('themeBtn');
    function applyTheme(t) {
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      const light = t === 'light';
      themeBtn.setAttribute('aria-pressed', String(light));
      themeBtn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      themeBtn.textContent = light ? 'dark' : 'light';
    }
    let savedTheme = null;
    try { savedTheme = localStorage.getItem('failora_theme'); } catch (e) {}
    applyTheme(savedTheme === 'light' ? 'light' : 'dark');
    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      applyTheme(next);
      try { localStorage.setItem('failora_theme', next); } catch (e) {}
    });

    /* ---------- Nav ---------- */
    const nav = document.getElementById('nav');
    const navLinks = [...document.querySelectorAll('[data-nav]')];
    const navTargets = navLinks.map(a => document.querySelector(a.getAttribute('href')));
    const menuBtn = document.getElementById('menuBtn');
    const mobile = document.getElementById('mobile');
    function setMenu(open) {
      mobile.classList.toggle('open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.textContent = open ? 'close' : 'menu';
    }
    menuBtn.addEventListener('click', () => setMenu(!mobile.classList.contains('open')));
    mobile.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

    function onScroll() {
      nav.classList.toggle('scrolled', scrollY > 20);
      let active = -1;
      navTargets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < innerHeight * 0.4) active = i; });
      navLinks.forEach((a, i) => {
        const on = i === active;
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      });
    }
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ---------- Copy buttons ---------- */
    document.querySelectorAll('.has-copy').forEach((block) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'Copy commands');
      btn.addEventListener('click', async () => {
        const text = block.dataset.copy || block.textContent;
        let ok = false;
        try { await navigator.clipboard.writeText(text); ok = true; } catch (e) {
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { ok = document.execCommand('copy'); } catch (err) {}
          ta.remove();
        }
        btn.textContent = ok ? 'copied' : 'failed';
        btn.dataset.state = ok ? 'done' : '';
        setTimeout(() => { btn.textContent = 'copy'; btn.dataset.state = ''; }, 1600);
      });
      block.appendChild(btn);
    });

    /* ---------- Reveal ---------- */
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        revealIO.unobserve(e.target);
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => { if (!el.classList.contains('in')) revealIO.observe(el); });

    /* ---------- Hero title: character reveal ---------- */
    (function () {
      const t = document.getElementById('heroTitle');
      if (reduce) return;
      const textNodes = [];
      (function walk(node) {
        [...node.childNodes].forEach((n) => {
          if (n.nodeType === 3) textNodes.push(n);
          else if (n.nodeType === 1 && n.tagName !== 'BR') walk(n);
        });
      })(t);
      let k = 0;
      textNodes.forEach((n) => {
        if (!n.textContent.trim()) return;
        const frag = document.createDocumentFragment();
        [...n.textContent].forEach((ch) => {
          const s = document.createElement('span');
          s.textContent = ch;
          s.style.opacity = '0';
          s.style.transition = 'opacity 0.12s linear';
          s.dataset.k = k++;
          frag.appendChild(s);
        });
        n.replaceWith(frag);
      });
      const chars = [...t.querySelectorAll('span[data-k]')];
      chars.forEach((c, i) => setTimeout(() => { c.style.opacity = '1'; }, 300 + i * 22));
      const sub = document.querySelector('.hero-sub');
      sub.style.opacity = '0';
      setTimeout(() => { sub.style.transition = 'opacity 0.8s'; sub.style.opacity = '1'; }, 300 + chars.length * 22 + 200);
    })();

    /* ---------- Scan input: validation, placeholder rotation, simulated output ---------- */
    const form = document.getElementById('scanForm');
    const input = document.getElementById('target');
    const cmdBox = document.getElementById('cmdBox');
    const formErr = document.getElementById('formErr');
    const scanOut = document.getElementById('scanOut');
    const scanLines = document.getElementById('scanLines');
    let scanTimers = [];

    const placeholders = ['https://your-site.com', 'github.com/owner/repo', 'https://api.example.com/respond'];
    let phIdx = 0;
    if (!reduce) {
      setInterval(() => {
        if (document.activeElement === input || input.value) return;
        phIdx = (phIdx + 1) % placeholders.length;
        input.placeholder = placeholders[phIdx];
      }, 2800);
    }

    function validTarget(v) {
      const s = v.trim();
      if (!s) return false;
      return /^(https?:\/\/)?[a-z0-9-]+(\.[a-z0-9-]+)+(\/\S*)?$/i.test(s)
          || /^(https?:\/\/)?github\.com\/[\w.-]+\/[\w.-]+\/?$/i.test(s);
    }
    function setErr(msg) {
      formErr.textContent = msg;
      cmdBox.classList.toggle('invalid', !!msg);
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    }

    const API_BASE = 'http://127.0.0.1:4200';

    async function runScan(target) {
      scanTimers.forEach(clearTimeout); scanTimers = [];
      scanLines.querySelectorAll('.l').forEach(n => n.remove());
      scanOut.classList.add('show');

      const isGitHub = /^(https?:\/\/)?github\.com\/[\w.-]+\/[\w.-]+\/?$/i.test(target.trim());
      const url = target.trim().replace(/^https?:\/\//, '');

      const addLine = (html, delay = 0) => new Promise(res => {
        const t = setTimeout(() => {
          const div = document.createElement('div');
          div.className = 'l shown';
          div.innerHTML = html;
          scanLines.appendChild(div);
          res(div);
        }, reduce ? 0 : delay);
        scanTimers.push(t);
      });

      try {
        await addLine(`<span class="p">$</span> failora scan ${esc(target)}`, 0);
        await addLine(`<span class="d">[ .. ]</span> resolving target`, 400);
        await addLine(`<span class="ok">[ OK ]</span> target resolved`, 800);

        if (isGitHub) {
          // GitHub repo scan
          const parts = url.replace(/^github\.com\//, '').split('/');
          const owner = parts[0], repo = parts[1];
          await addLine(`<span class="d">[ .. ]</span> scanning GitHub repo ${esc(owner)}/${esc(repo)}`, 1200);

          const res = await fetch(`${API_BASE}/scan-repo`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ owner, repo })
          });
          const data = await res.json();

          if (!res.ok) throw new Error(data.error || `repo scan failed (${res.status})`);
          
          await addLine(`<span class="ok">[ OK ]</span> repo scan complete`, 1600);
          await addLine(`<span class="info">[ >> ]</span> branch: ${esc(data.branch || '?')} | files: ${data.files?.total || 0} | score: ${data.score ?? '—'}/100`, 2000);
          
          if (data.findings?.length > 0) {
            await addLine(`<span class="warn">[WARN]</span> ${data.findings.length} findings: ${data.summary?.critical || 0} critical, ${data.summary?.high || 0} high`, 2400);
            for (let i = 0; i < Math.min(3, data.findings.length); i++) {
              const f = data.findings[i];
              await addLine(`<span class="d">[ .. ]</span> ${esc(f.title)} <span class="dim">(${esc(f.severity)})</span>`, 2800 + i * 400);
            }
          } else {
            await addLine(`<span class="ok">[ OK ]</span> no issues found — clean repo!`, 2400);
          }
        } else {
          // URL scan
          const scanUrl = target.trim().startsWith('http') ? target.trim() : `https://${target.trim()}`;
          await addLine(`<span class="d">[ .. ]</span> checking availability and response time`, 1200);

          const res = await fetch(`${API_BASE}/scans`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: scanUrl })
          });
          const scan = await res.json();

          if (!res.ok) throw new Error(scan.error || 'scan failed');
          await addLine(`<span class="ok">[ OK ]</span> scan started (id: ${scan.id.slice(0,8)}...)`, 1600);
          await addLine(`<span class="d">[ .. ]</span> running checks...`, 2000);

          // Poll for result
          let result;
          for (let i = 0; i < 30; i++) {
            await new Promise(r => setTimeout(r, 1000));
            const pollRes = await fetch(`${API_BASE}/scans/${scan.id}`);
            result = await pollRes.json();
            if (result.status === 'completed' || result.status === 'failed') break;
          }

          if (result.status === 'completed') {
            const r = JSON.parse(result.result || '{}');
            await addLine(`<span class="ok">[ OK ]</span> ${r.health?.status || 200} OK, ${r.health?.responseTimeMs || '?'} ms`, 2400);
            await addLine(`<span class="d">[ .. ]</span> reviewing headers and configuration`, 2800);
            if (r.security?.issues?.length) {
              await addLine(`<span class="warn">[WARN]</span> ${r.security.issues[0].description || 'security issue found'}`, 3200);
            }
            await addLine(`<span class="ok">[ OK ]</span> score: ${result.score ?? r.overallScore ?? '—'}/100`, 3600);
            await addLine(`<span class="info">[ >> ]</span> report ready, opening findings below`, 4000);
          } else {
            await addLine(`<span class="err">[FAIL]</span> scan failed: ${result.error || 'unknown'}`, 2400);
          }
        }

        document.getElementById('report').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        openFinding(0, true);
      } catch (err) {
        await addLine(`<span class="err">[ERR ]</span> ${esc(err.message)}`, 0);
        await addLine(`<span class="d">[ .. ]</span> make sure the Failora API is running on ${API_BASE}`, 400);
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validTarget(input.value)) {
        setErr('invalid target. Use a website URL or a GitHub repo, e.g. github.com/owner/repo');
        input.focus();
        return;
      }
      setErr('');
      runScan(input.value.trim());
    });
    input.addEventListener('input', () => { if (formErr.textContent) setErr(''); });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      document.getElementById('report').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
      openFinding(0, true);
    });

    /* ---------- Command palette (Ctrl/Cmd+K) and "/" shortcut ---------- */
    const palBack = document.getElementById('palBack');
    const palInput = document.getElementById('palInput');
    const palList = document.getElementById('palList');
    const palBtn = document.getElementById('palBtn');
    const palItems = [
      { label: 'Product dashboard', href: '#product', hint: 'product' },
      { label: 'Features', href: '#features', hint: 'features' },
      { label: 'How it works', href: '#how', hint: 'pipeline' },
      { label: 'Quickstart commands', href: '#quickstart', hint: 'run it' },
      { label: 'Sample report', href: '#report', hint: 'findings' },
      { label: 'Status: what is available', href: '#status', hint: 'status' },
      { label: 'Privacy', href: '#privacy', hint: 'privacy' },
      { label: 'FAQ', href: '#docs', hint: 'help' },
      { label: 'Scan a target', href: '#top', hint: 'scan' },
    ];
    let palSel = 0, palFiltered = palItems, lastFocus = null;

    function renderPal() {
      const q = palInput.value.trim().toLowerCase();
      palFiltered = palItems.filter(it => !q || it.label.toLowerCase().includes(q) || it.hint.includes(q));
      if (palSel >= palFiltered.length) palSel = 0;
      palList.innerHTML = palFiltered.map((it, i) => `
        <li role="option" aria-selected="${i === palSel}"><button type="button" data-i="${i}" aria-selected="${i === palSel}"><span>${esc(it.label)}</span><span>${esc(it.hint)}</span></button></li>`).join('')
        || '<li class="m" style="padding:10px 12px;color:var(--dim)">no matches</li>';
    }
    function openPal() {
      lastFocus = document.activeElement;
      palBack.hidden = false;
      palInput.value = '';
      palSel = 0;
      renderPal();
      palInput.focus();
    }
    function closePal() {
      palBack.hidden = true;
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    function goPal(i) {
      const it = palFiltered[i];
      if (!it) return;
      closePal();
      const t = document.querySelector(it.href);
      if (t) t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    }
    palBtn.addEventListener('click', openPal);
    palInput.addEventListener('input', () => { palSel = 0; renderPal(); });
    palList.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-i]');
      if (b) goPal(+b.dataset.i);
    });
    palBack.addEventListener('click', (e) => { if (e.target === palBack) closePal(); });
    palInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); palSel = (palSel + 1) % Math.max(1, palFiltered.length); renderPal(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); palSel = (palSel - 1 + palFiltered.length) % Math.max(1, palFiltered.length); renderPal(); }
      else if (e.key === 'Enter') { e.preventDefault(); goPal(palSel); }
      else if (e.key === 'Escape') { e.preventDefault(); closePal(); }
      else if (e.key === 'Tab') { e.preventDefault(); }
    });

    addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        palBack.hidden ? openPal() : closePal();
      } else if (e.key === '/' && !typing && palBack.hidden) {
        e.preventDefault();
        input.focus();
      } else if (e.key === 'Escape') {
        if (!palBack.hidden) closePal();
        else if (mobile.classList.contains('open')) { setMenu(false); menuBtn.focus(); }
      }
    });

    /* ---------- How it works: stages light up in sequence ---------- */
    (function () {
      const stages = [...document.querySelectorAll('[data-stage]')];
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          stages.forEach((s, i) => setTimeout(() => {
            s.classList.add('on');
            s.querySelector('.state').textContent = 'done';
          }, reduce ? 0 : i * 450));
        });
      }, { threshold: 0.4 });
      io.observe(document.getElementById('pipe'));
    })();

    /* ---------- Dashboard: sparklines, severity bars, counters ---------- */
    (function () {
      const blocks = '▁▂▃▄▅▆▇█';
      const hb = document.getElementById('heartbeat');
      let hbHTML = '';
      for (let i = 0; i < 60; i++) {
        const bad = i === 14 || i === 41 || i === 52;
        if (bad) hbHTML += '<span class="f">▁</span>';
        else hbHTML += blocks[Math.min(7, 3 + Math.round(Math.abs(Math.sin(i * 0.9)) * 3) + (i % 3 === 0 ? 1 : 0))];
      }
      hb.innerHTML = hbHTML;

      const lat = document.getElementById('latency');
      const latVals = [];
      for (let x = 0; x < 48; x++) latVals.push(Math.round(220 + Math.sin(x / 4) * 26 + Math.sin(x / 1.7) * 9 + (x > 30 && x < 34 ? 40 : 0)));
      const min = Math.min(...latVals), max = Math.max(...latVals);
      lat.innerHTML = latVals.map(v => blocks[Math.min(7, Math.floor((v - min) / (max - min + 1) * 8))]).join('');

      const rows = [
        { label: 'critical', n: 1, w: 2, cls: 'r' },
        { label: 'high', n: 3, w: 6, cls: 'o' },
        { label: 'medium', n: 5, w: 10, cls: 'y' },
        { label: 'low', n: 8, w: 16, cls: 'b' },
      ];
      document.getElementById('sevBars').innerHTML = rows
        .map(r => `<b>${r.label.padEnd(9, ' ')}</b> <span class="bar ${r.cls}">${'█'.repeat(r.w)}</span>  ${r.n}`).join('\n');
    })();

    const countIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target;
        const target = parseFloat(el.dataset.count);
        const dec = +(el.dataset.dec || 0);
        if (reduce) { el.textContent = target.toFixed(dec); countIO.unobserve(el); return; }
        const start = performance.now(), dur = 1100;
        (function tick(now) {
          const p = Math.min(1, (now - start) / dur);
          el.textContent = (target * (1 - Math.pow(1 - p, 3))).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
        })(start);
        countIO.unobserve(el);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach(el => countIO.observe(el));

    /* ---------- Sample report: expandable findings + arrow keys ---------- */
    const findings = [
      {
        title: 'Retry ignores Retry-After on HTTP 429',
        sev: 'high', sevLabel: 'HIGH', meta: 'api/respond · src/client.ts:58',
        impact: 'Under load, the client retries too early and keeps receiving 429 responses, which slows recovery.',
        evidence: `<span class="c"># request log (sample)</span>
<span class="r">429</span> POST /respond  Retry-After: <span class="k">2</span>  retry #1 after <span class="k">0.2 s</span>
<span class="r">429</span> POST /respond  Retry-After: <span class="k">2</span>  retry #2 after <span class="k">0.2 s</span>
<span class="c"># src/client.ts:58</span>  <span class="k">await</span> sleep(backoffMs)   <span class="c">// header ignored</span>`,
        steps: [
          'Start the mock service and set /respond?mode=429.',
          'Send a POST request through the client.',
          'Watch the retry timing in the request log.',
          'Compare the delay with the Retry-After header.'
        ],
        fix: `<span class="c">// use the header value when present</span>
<span class="k">const</span> wait = <span class="k">Number</span>(res.headers.get(<span class="g">'retry-after'</span>)) * 1000 || backoffMs;
<span class="k">await</span> sleep(wait);`,
        verdict: 'v', verdictLabel: 'VERIFIED', verifyText: 'Sample run: 3 of 3 retries waited for Retry-After.'
      },
      {
        title: 'No fallback on malformed JSON',
        sev: 'med', sevLabel: 'MEDIUM', meta: 'api/respond · src/ai.ts:31',
        impact: 'A broken response body fails the whole request instead of switching to the fallback path.',
        evidence: `<span class="c"># recovery test (sample)</span>
mode=malformed   -&gt;  <span class="r">JSON.parse failed</span>
fallback path    -&gt;  <span class="r">not triggered</span>
<span class="c"># src/ai.ts:31</span>  <span class="k">catch</span> (e) { <span class="k">throw</span> e }`,
        steps: [
          'Set /respond?mode=malformed on the mock service.',
          'Run the malformed-response scenario.',
          'Check whether the fallback handler runs.',
          'Confirm the request fails with no recovery.'
        ],
        fix: `<span class="k">catch</span> (e) {
  <span class="k">return</span> <span class="k">await</span> fallbackModel(prompt); <span class="c">// recover</span>
}`,
        verdict: 'p', verdictLabel: 'PENDING RE-TEST', verifyText: 'Fix suggested. Re-run the scenario to verify recovery.'
      },
      {
        title: 'Missing Cache-Control on /health',
        sev: 'low', sevLabel: 'LOW', meta: 'website (planned check)',
        impact: 'Health checks may return cached responses from intermediaries, which can hide real outages.',
        evidence: `<span class="c"># header check (sample)</span>
GET /health   200 OK
Cache-Control: <span class="r">(missing)</span>`,
        steps: [
          'Request /health from a clean client.',
          'Inspect the response headers.',
          'Confirm Cache-Control is absent.'
        ],
        fix: `<span class="c"># add to the health route</span>
Cache-Control: <span class="g">no-store</span>`,
        verdict: 'q', verdictLabel: 'PARTIALLY VERIFIED', verifyText: 'Header confirmed missing. Fix not re-tested yet.'
      }
    ];

    const wrapF = document.getElementById('findings');
    wrapF.innerHTML = findings.map((f, i) => `
      <div class="f-item">
        <button class="f-btn" type="button" id="fb-${i}" aria-controls="fp-${i}" aria-expanded="false" data-i="${i}">
          <span class="sev ${f.sev}">${f.sevLabel}</span>
          <span>
            <span class="f-title" style="display:block">${esc(f.title)}</span>
            <span class="f-meta" style="display:block">${esc(f.meta)}</span>
          </span>
          <span class="f-toggle" aria-hidden="true">&#9656;</span>
        </button>
        <div class="f-panel" id="fp-${i}" role="region" aria-labelledby="fb-${i}">
          <h4>impact</h4><p>${esc(f.impact)}</p>
          <h4>evidence</h4><div class="code">${f.evidence}</div>
          <h4>steps to reproduce</h4><ol>${f.steps.map(s => `<li>${esc(s)}</li>`).join('')}</ol>
          <h4>recommended fix</h4><div class="code has-copy" data-copy="${esc(f.fix.replace(/<[^>]+>/g, ''))}">${f.fix}</div>
          <h4>verification status</h4>
          <span class="verdict ${f.verdict}">${f.verdictLabel}</span>
          <p style="margin-top:6px">${esc(f.verifyText)}</p>
        </div>
      </div>`).join('');

    // Attach copy buttons to fix blocks rendered above
    wrapF.querySelectorAll('.has-copy').forEach((block) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy';
      btn.textContent = 'copy';
      btn.addEventListener('click', async () => {
        let ok = false;
        try { await navigator.clipboard.writeText(block.dataset.copy); ok = true; } catch (e) {}
        btn.textContent = ok ? 'copied' : 'failed';
        btn.dataset.state = ok ? 'done' : '';
        setTimeout(() => { btn.textContent = 'copy'; btn.dataset.state = ''; }, 1600);
      });
      block.appendChild(btn);
    });

    function setFinding(i, open) {
      document.getElementById('fb-' + i).setAttribute('aria-expanded', String(open));
      document.getElementById('fp-' + i).classList.toggle('open', open);
    }
    function openFinding(i, focus) {
      setFinding(i, true);
      if (focus) document.getElementById('fb-' + i).focus({ preventScroll: true });
    }
    wrapF.addEventListener('click', (e) => {
      const btn = e.target.closest('.f-btn');
      if (!btn) return;
      const i = +btn.dataset.i;
      setFinding(i, btn.getAttribute('aria-expanded') !== 'true');
    });
    wrapF.addEventListener('keydown', (e) => {
      const btns = [...wrapF.querySelectorAll('.f-btn')];
      const idx = btns.indexOf(document.activeElement);
      if (idx < 0) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); btns[(idx + 1) % btns.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); btns[(idx - 1 + btns.length) % btns.length].focus(); }
    });

    /* ---------- AUTH: sign in / register ---------- */
    (function () {
      const API = 'http://127.0.0.1:4200';
      const authBack = document.getElementById('authBack');
      const signInBtn = document.getElementById('signInBtn');
      const mobileSignIn = document.getElementById('mobileSignIn');
      const authClose = document.getElementById('authClose');
      const authUser = document.getElementById('authUser');
      const authAvatar = document.getElementById('authAvatar');
      const authName = document.getElementById('authName');
      const authLogout = document.getElementById('authLogout');
      const tabLogin = document.getElementById('tabLogin');
      const tabRegister = document.getElementById('tabRegister');
      const loginForm = document.getElementById('loginForm');
      const registerForm = document.getElementById('registerForm');
      const authErr = document.getElementById('authErr');
      const authSuccess = document.getElementById('authSuccess');
      const switchText = document.getElementById('switchText');
      const switchLink = document.getElementById('switchLink');
      const authTitle = document.getElementById('authTitle');

      let isLogin = true;
      let token = localStorage.getItem('failora_token');

      function showErr(msg) {
        authErr.textContent = msg;
        authErr.classList.add('show');
        authSuccess.classList.remove('show');
      }
      function showSuccess(msg) {
        authSuccess.textContent = msg;
        authSuccess.classList.add('show');
        authErr.classList.remove('show');
      }
      function clearMsg() {
        authErr.classList.remove('show');
        authSuccess.classList.remove('show');
      }

      function setTab(login) {
        isLogin = login;
        tabLogin.classList.toggle('active', login);
        tabRegister.classList.toggle('active', !login);
        loginForm.style.display = login ? 'block' : 'none';
        registerForm.style.display = login ? 'none' : 'block';
        switchText.textContent = login ? 'No account?' : 'Have an account?';
        switchLink.textContent = login ? 'Register' : 'Sign in';
        authTitle.textContent = login ? 'auth login' : 'auth register';
        clearMsg();
      }

      function openAuth() {
        authBack.classList.add('open');
        clearMsg();
        setTimeout(() => (isLogin ? document.getElementById('loginEmail') : document.getElementById('regName')).focus(), 100);
      }
      function closeAuth() {
        authBack.classList.remove('open');
      }

      function showUser(user) {
        authUser.style.display = 'flex';
        signInBtn.style.display = 'none';
        mobileSignIn.textContent = user.name;
        authAvatar.textContent = user.name.charAt(0).toUpperCase();
        authName.textContent = user.name;
      }
      function hideUser() {
        authUser.style.display = 'none';
        signInBtn.style.display = 'block';
        mobileSignIn.textContent = 'sign in';
      }

      async function checkAuth() {
        if (!token) return;
        try {
          const res = await fetch(`${API}/auth/me`, {
            headers: { Authorization: `Bearer ${token}` }
          });
          if (res.ok) {
            const user = await res.json();
            showUser(user);
          } else {
            localStorage.removeItem('failora_token');
            token = null;
            hideUser();
          }
        } catch {
          // API down — stay logged out
        }
      }

      async function doLogin(e) {
        e.preventDefault();
        clearMsg();
        const btn = loginForm.querySelector('.auth-submit');
        btn.disabled = true;
        
        const email = document.getElementById('loginEmail').value.trim();
        const password = document.getElementById('loginPass').value;
        
        console.log('[Failora Auth] Login attempt:', { email, passwordLength: password.length });
        
        try {
          const res = await fetch(`${API}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });
          const data = await res.json();
          
          console.log('[Failora Auth] Response:', res.status, data);
          
          if (!res.ok) throw new Error(data.error || 'Login failed');

          token = data.token;
          localStorage.setItem('failora_token', token);
          showUser(data.user);
          showSuccess(`Welcome back, ${data.user.name}!`);
          setTimeout(closeAuth, 800);
        } catch (err) {
          showErr(err.message);
        } finally {
          btn.disabled = false;
        }
      }

      async function doRegister(e) {
        e.preventDefault();
        clearMsg();
        const btn = registerForm.querySelector('.auth-submit');
        btn.disabled = true;
        try {
          const res = await fetch(`${API}/auth/register`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: document.getElementById('regName').value,
              email: document.getElementById('regEmail').value,
              password: document.getElementById('regPass').value
            })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Registration failed');

          showSuccess('Account created! You can now sign in.');
          setTab(true);
        } catch (err) {
          showErr(err.message);
        } finally {
          btn.disabled = false;
        }
      }

      function doLogout() {
        localStorage.removeItem('failora_token');
        token = null;
        hideUser();
      }

      // Events
      signInBtn.addEventListener('click', openAuth);
      mobileSignIn.addEventListener('click', () => { if (!token) openAuth(); });
      authClose.addEventListener('click', closeAuth);
      authBack.addEventListener('click', (e) => { if (e.target === authBack) closeAuth(); });
      tabLogin.addEventListener('click', () => setTab(true));
      tabRegister.addEventListener('click', () => setTab(false));
      switchLink.addEventListener('click', () => setTab(!isLogin));
      loginForm.addEventListener('submit', doLogin);
      registerForm.addEventListener('submit', doRegister);
      authLogout.addEventListener('click', doLogout);

      // Esc to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && authBack.classList.contains('open')) closeAuth();
      });

      // Check existing session
      checkAuth();
    })();
  </script>
</body>
</html>

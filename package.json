{
  "name": "failora",
  "version": "0.1.0",
  "private": true,
  "description": "AI Reliability and Recovery Verification Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mock-ai": "npm run start --workspace=packages/mock-ai"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
